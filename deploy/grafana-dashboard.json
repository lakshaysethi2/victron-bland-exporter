{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "8.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous"
          },
          "unit": "watt-hour"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "victron_yield_today_wh",
          "legendFormat": "{{device}}"
        }
      ],
      "title": "Yield today",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "watt"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "victron_solar_power_watts",
          "legendFormat": "{{device}}"
        }
      ],
      "title": "Solar power",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "volt"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "victron_battery_voltage_volts",
          "legendFormat": "{{device}}"
        }
      ],
      "title": "Battery voltage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "amp"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "victron_battery_current_amps",
          "legendFormat": "{{device}}"
        }
      ],
      "title": "Battery current",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "targets": [
        {
          "expr": "victron_devices_total",
          "legendFormat": "devices"
        }
      ],
      "title": "Devices online",
      "type": "stat"
    }
  ],
  "refresh": "10s",
  "tags": [
    "solar",
    "victron"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Solar — Victron MPPT",
  "uid": "victron-solar",
  "version": 1
}
