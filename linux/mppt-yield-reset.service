[Unit]
Description=Pulse Victron MPPT when solar watts drop below recent peak
After=bluetooth.target network.target

[Service]
Type=simple
WorkingDirectory=%h/mppt-ble
EnvironmentFile=%h/.config/mppt/secrets.env
ExecStart=%h/.venv/mppt-ble/bin/python -m mppt_ble.yield_reset --mac ${MPPT_MAC} --metrics ${MPPT_METRICS_URL}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
