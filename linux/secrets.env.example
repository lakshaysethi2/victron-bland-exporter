# Copy to ~/.config/mppt/secrets.env (mode 600). Never commit the real file.
MPPT_REMOTE_SECRET=change-me
MPPT_MAC=AA:BB:CC:DD:EE:FF
MPPT_PUBLIC_HOST=charger.example.com
MPPT_METRICS_URL=http://127.0.0.1:5338/metrics
CLOUDFLARED_TOKEN_FILE=/home/YOU/.config/mppt/tunnel.token
# Optional. If set, GET /node/metrics proxies this URL (local node-exporter).
# Leave unset to keep /node/metrics as 404.
# NODE_EXPORTER_URL=http://127.0.0.1:9100/metrics
# Optional. Caps auto-pulses in a rolling hour (overrides yield_config.json).
# MPPT_MAX_PULSES_PER_HOUR=4
