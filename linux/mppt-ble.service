[Unit]
Description=Victron SmartSolar BLE charger control (BlueZ)
After=bluetooth.target network.target

[Service]
Type=simple
WorkingDirectory=%h/mppt-ble
ExecStart=%h/.venv/mppt-ble/bin/python -m mppt_ble serve --mac DC:AD:B0:54:DB:4E --bind 0.0.0.0:5340
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
